{
  "name": "dopus-md-viewer-webbuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Build-time only: bundles web/app.js and web/mermaid.js. Nothing here is shipped.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node dev-server.mjs",
    "test": "node test/highlight-split.mjs && node test/whitespace-mark.mjs"
  },
  "dependencies": {
    "@mdit/plugin-alert": "^2.0.3",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.2.0",
    "highlight.js": "^11.11.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.0.0"
  },
  "overrides": {
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
