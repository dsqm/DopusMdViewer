# —— 构建产物 ——
bin/
build/
obj/
*.obj
*.res
*.exp
*.pdb
*.ilk
*.exe

# —— 前端打包产物：node build.mjs 重新生成 ——
web/app.js
web/mermaid.js
web/katex.css
web/fonts/

# —— 前端构建依赖 ——
webbuild/node_modules/

# —— 会话过程产物：决策地图、票、调研原始输出、验收截图 ——
.scratch/

# —— 本地 agent 配置：保留在磁盘，不入库 ——
AGENTS.md
docs/agents/

# —— 本机临时文件 ——
*.log
*.lnk

# —— 基线样本：脚本生成，不入库 ——
samples/big-*.md

# —— 手动验收的大样本：samples/manual-test/gen.py 生成，不入库 ——
samples/manual-test/big-*
*.lnk

# —— 皮肤编辑器发布目录：exe、assets、zip 与运行时缓存不入库，打包脚本保留 ——
# 上面的 bin/ 会忽略整个目录，先把这个目录放回来，再逐项排除。
!tools/skinedit/bin/
tools/skinedit/bin/*
!tools/skinedit/bin/pack.bat
