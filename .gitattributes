# 源码与 web 资产：UTF-8 + LF
* text=auto eol=lf

# 启动脚本在工作区保持 ANSI(GBK) + CRLF。
# GBK 文件交给 working-tree-encoding：仓库里存 UTF-8（diff 可读），检出时转回 GBK。
# 编辑这两个文件时必须按 GBK 保存；存成 UTF-8 会被 Git 当作 GBK 解码。
# build-encdetect.bat 本身是 UTF-8，不套这项转换。
*.bat text eol=crlf
build.bat       text working-tree-encoding=GBK eol=crlf
build-pcre2.bat text working-tree-encoding=GBK eol=crlf

# vendored 的 WebView2 SDK 保持字节一致，不让 git 改行尾
sdk/** -text

# vendored 第三方源码同样保持字节一致（third_party/compact_enc_det 的 VENDOR.md 声明与上游一致）
third_party/compact_enc_det/** -text

# 二进制
*.dll   binary
*.lib   binary
*.exe   binary
*.woff2 binary
*.png   binary
*.ico   binary
