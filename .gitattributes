# 源码与 web 资产：UTF-8 + LF
* text=auto eol=lf

# 启动脚本必须保持 ANSI(GBK) + CRLF。git 只做行尾转换，不改编码，
# 所以这里不用 working-tree-encoding —— 那个一旦被别的工具写坏就没法还原。
*.bat text eol=crlf

# vendored 的 WebView2 SDK 保持字节一致，不让 git 改行尾
sdk/** -text

# vendored 第三方源码同样保持字节一致（third_party/compact_enc_det 的 VENDOR.md 声明与上游一致）
third_party/compact_enc_det/** -text

# 二进制
*.dll   binary
*.lib   binary
*.exe   binary
*.woff2 binary
*.png   binary
*.ico   binary
