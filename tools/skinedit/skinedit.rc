// skinedit.rc — 皮肤编辑器外壳的版本信息。
//
// 版本号不写在这里：构建时 build.py 调 tools\gen-version.ps1 按当前时刻生成
// build\obj-skinedit\version.rc.inc（build\ 不入库），下面直接引用它的宏。
// 缺这个文件说明没走构建脚本，rc 会在这里报找不到 include。
//
// 图标留空：仓库里没有 .ico。要加的时候放一个 tools\skinedit\skinedit.ico，下面补
// 一行 IDI_ICON ICON "skinedit.ico"，并在 skinedit.cpp 的 WNDCLASSEXW 里给
// hIcon / hIconSm 填 LoadIconW(inst, MAKEINTRESOURCEW(IDI_ICON))——光有资源不填
// 窗口类，窗口还是系统默认图标。

#include <windows.h>
#include "version.rc.inc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MDV_VER_NUMERIC
 PRODUCTVERSION MDV_VER_NUMERIC
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DopusMdViewer"
            VALUE "FileDescription",  "DopusMdViewer skin editor"
            VALUE "FileVersion",      MDV_VER_STRING
            VALUE "InternalName",     "skinedit"
            VALUE "LegalCopyright",   "(c) 2026 DopusMdViewer contributors"
            VALUE "OriginalFilename", "skinedit.exe"
            VALUE "ProductName",      "DopusMdViewer skin editor"
            VALUE "ProductVersion",   MDV_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
