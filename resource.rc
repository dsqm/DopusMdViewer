// resource.rc - version information only.
// RC compiler is invoked with the same INCLUDE paths as the C++ build.

#include <windows.h>
#include "src/resource_ids.h"

IDD_CONFIG_HELP DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DopusMdViewer"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_HELP_TEXT, 7, 7, 246, 110, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Copy", IDC_HELP_COPY, 140, 125, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 196, 125, 50, 14
END

// 外部链接确认框：文本在 WM_INITDIALOG 里写（.rc 保持纯 ASCII）。
IDD_OPEN_CONFIRM DIALOGEX 0, 0, 300, 104
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open external link"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_OPEN_WARN, 10, 8, 280, 20
    EDITTEXT        IDC_OPEN_URL, 10, 32, 280, 40, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Open", IDC_OPEN_GO, 186, 82, 50, 14, WS_DISABLED
    DEFPUSHBUTTON   "Cancel", IDCANCEL, 240, 82, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DopusMdViewer"
            VALUE "FileDescription",  "DopusMdViewer - Markdown viewer for Directory Opus (POC)"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "DopusMdViewer"
            VALUE "LegalCopyright",   "(c) 2026 DopusMdViewer contributors"
            VALUE "OriginalFilename", "DopusMdViewer.dll"
            VALUE "ProductName",      "DopusMdViewer"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
