// resource.rc - version information + the settings help dialog (IDD_CONFIG_HELP).
// RC compiler is invoked with the same INCLUDE paths as the C++ build.
//
// 版本号不写在这里：构建时由 tools\gen-version.ps1 按当前时刻生成
// build\obj\version.rc.inc（build\ 不入库），下面直接引用它的宏。
// 缺这个文件说明没走构建脚本，rc 会在这里报找不到 include。

#include <windows.h>
#include "src/resource_ids.h"
#include "build/obj/version.rc.inc"

IDD_CONFIG_HELP DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DopusMdViewer"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_HELP_TEXT, 7, 7, 246, 110, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Copy", IDC_HELP_COPY, 140, 125, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 196, 125, 50, 14
END

; Extension list editor. All labels are set by ViewerExtsDlgProc in
; WM_INITDIALOG from the string table; the English text here is a placeholder.
IDD_VIEWER_EXTS DIALOGEX 0, 0, 300, 180
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DopusMdViewer"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_EXTS_HINT, 7, 7, 286, 20
    EDITTEXT        IDC_EXTS_TEXT, 7, 29, 286, 122, ES_MULTILINE | WS_VSCROLL | ES_AUTOVSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Defaults", IDC_EXTS_DEFAULT, 7, 158, 62, 15
    DEFPUSHBUTTON   "OK", IDOK, 182, 158, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 238, 158, 55, 15
END

; Font preview text editor. Labels come from PreviewTextDlgProc in WM_INITDIALOG;
; ES_WANTRETURN keeps Enter inside the edit control for line breaks.
IDD_PREVIEW_TEXT DIALOGEX 0, 0, 300, 180
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DopusMdViewer"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PREVIEW_HINT, 7, 7, 286, 26
    EDITTEXT        IDC_PREVIEW_TEXT, 7, 36, 286, 112, ES_MULTILINE | ES_WANTRETURN | WS_VSCROLL | ES_AUTOVSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Defaults", IDC_PREVIEW_DEFAULT, 7, 155, 62, 15
    DEFPUSHBUTTON   "OK", IDOK, 182, 155, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 238, 155, 55, 15
END

; Skin tool help. Labels are set by SkinHelpDlgProc in WM_INITDIALOG.
IDD_SKIN_HELP DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DopusMdViewer"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_SKIN_HELP_TEXT, 7, 7, 246, 110, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Open", IDC_SKIN_HELP_OPEN, 130, 125, 60, 14
    DEFPUSHBUTTON   "Close", IDOK, 196, 125, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MDV_VER_NUMERIC
 PRODUCTVERSION MDV_VER_NUMERIC
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DopusMdViewer"
            VALUE "FileDescription",  "DopusMdViewer - Markdown viewer for Directory Opus"
            VALUE "FileVersion",      MDV_VER_STRING
            VALUE "InternalName",     "DopusMdViewer"
            VALUE "LegalCopyright",   "Copyright (c) 2026 dsqm / DopusMdViewer"
            VALUE "OriginalFilename", "DopusMdViewer.dll"
            VALUE "ProductName",      "DopusMdViewer"
            VALUE "ProductVersion",   MDV_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
